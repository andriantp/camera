# Camera address. Without a scheme, HTTP is used.
# ONVIF always uses HTTP; for an https:// host it connects to the default HTTP port.
Host     = ip:port
# Host     = https://ip:port

User     = admin
# Quote the password if it contains spaces or " #": Password = "my #pass"
Password = camera-password

# Optional, ISAPI only: needed when Host uses https:// with a self-signed certificate.
# CACert   = /path/to/camera.crt   # trust this certificate (recommended)
# Insecure = true                  # skip certificate verification (trusted network only)

# Optional
# Channel  = 1          # ISAPI channel (default 1)
# Profile  = profile_1  # ONVIF profile token (default profile_1)
